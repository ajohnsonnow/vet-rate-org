# .aiignore — Shield sensitive files from AI context crawlers

# Mirrors .gitignore semantics. Prevents secrets, build artifacts,

# and irrelevant files from being injected into AI agent context.

# Generated by claude-toolkit Phase 4.

# ── Secrets & Environment — NEVER expose to AI context ────────────────────────

.env
.env.*
*.pem
*.key
*.cert
*.p12
*.pfx
secrets.json
credentials.json
.netrc
.npmrc
.pypirc
client_secret_*.json

# ── Build Outputs — irrelevant to code understanding ──────────────────────────

dist/
dist-supplylocker/
build/
.next/
.nuxt/
.output/
out/
target/
*.min.js
*.min.css
*.bundle.js
*.map

# ── Dependencies — auto-generated, not authored code ──────────────────────────

node_modules/
.pnp.cjs
.yarn/
__pycache__/
*.pyc
.venv/
venv/
.tox/
vendor/

# ── Version Control Internals ─────────────────────────────────────────────────

.git/
.hg/
.svn/

# ── IDE and OS Metadata ──────────────────────────────────────────────────────

.idea/
.vscode/settings.json
*.DS_Store
Thumbs.db
desktop.ini

# ── Test Artifacts — generated during CI ──────────────────────────────────────

coverage/
.nyc_output/
test-results/
playwright-report/
screenshots/
*.snap

# ── VetRate-Specific Exclusions ───────────────────────────────────────────────

# Archived docs — large, historical, not relevant to active development

archive/
audit/

# LLM compiler internals — not source code

llm-compiler/

# Scraper logs and raw data

full_scrape_log.txt
*.tmp

# Binary/generated assets

public/models/
*.wasm
*.onnx

# Lock files — auto-generated

package-lock.json
yarn.lock
pnpm-lock.yaml
pnpm-lock.yaml
