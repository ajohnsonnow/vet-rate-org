# Environment Configuration
# Copy this file to .env.local and fill in values as needed

# Application
VITE_APP_NAME=Veteran Disability Search
VITE_APP_VERSION=1.0.0
VITE_API_BASE_URL=https://www.ecfr.gov

# Feature Flags
VITE_ENABLE_PDF_GENERATION=true
VITE_ENABLE_ANALYTICS=false

# Security
VITE_ALLOWED_SEARCH_LENGTH=100
VITE_SEARCH_DEBOUNCE_MS=300

# AI Statement Assistant (Optional)
# Get your free API key from: https://aistudio.google.com/app/apikey
# The free tier allows 15 requests/minute and 1,500 requests/day
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# VA.gov API Configuration (Required for VA Integration Demo)
# ============================================================
# Get your Client ID from: https://developer.va.gov/
# Register your application and request "Authorization Code Grant" access
# 
# Required OAuth Scopes for Demo:
#   - openid
#   - profile  
#   - offline_access
#   - claim.read
#   - service_history.read
#   - appealable_issues.read

VITE_VA_CLIENT_ID=your_va_client_id_here
VITE_VA_REDIRECT_URL=http://localhost:5173/callback

# VA API Environment (sandbox for testing, production for live data)
# Use 'sandbox' until you receive VA Production Access approval
VITE_VA_API_ENV=sandbox

# VA Facilities API Key (for VSO Finder facility search)
# This is separate from OAuth - get it from developer.va.gov
# Used for unauthenticated facility lookups
VITE_VA_API_KEY=your_va_api_key_here
# Cloud Sync - Google Drive OAuth (Optional)
# Follow setup guide in README.md to enable Google Drive backup
# Get OAuth credentials: https://console.cloud.google.com/apis/credentials
# Required scope: https://www.googleapis.com/auth/drive.file
VITE_GOOGLE_DRIVE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com