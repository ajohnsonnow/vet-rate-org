# Environment Configuration
# Copy this file to .env.local and fill in values as needed

# Application
VITE_APP_NAME=Veteran Disability Search
VITE_APP_VERSION=1.0.0
VITE_API_BASE_URL=https://www.ecfr.gov

# Feature Flags
VITE_ENABLE_PDF_GENERATION=true
VITE_ENABLE_ANALYTICS=false

# Security
VITE_ALLOWED_SEARCH_LENGTH=100
VITE_SEARCH_DEBOUNCE_MS=300

# API Keys (if needed for future enhancements)
# VITE_VA_API_KEY=your_key_here
