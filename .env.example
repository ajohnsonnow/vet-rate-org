# ──────────────────────────────────────────────────────────────────────────────
#  Vet-Rate.org — Environment Configuration
#
#  Copy this file to `.env.local` and fill in the values you need.
#  All keys are optional unless marked REQUIRED.
#  Restart `npm run dev` after editing.
#
#  Get credentials:
#    - VA.gov OAuth + Facilities API: https://developer.va.gov/explore
#    - Google Gemini AI:              https://aistudio.google.com/app/apikey
#    - Google Drive (cloud sync):     https://console.cloud.google.com/apis/credentials
# ──────────────────────────────────────────────────────────────────────────────

# ─── Application ──────────────────────────────────────────────────────────────
VITE_APP_NAME=Veteran Disability Search
VITE_APP_VERSION=1.0.0
VITE_API_BASE_URL=https://www.ecfr.gov

# ─── Feature flags ────────────────────────────────────────────────────────────
VITE_ENABLE_PDF_GENERATION=true
VITE_ENABLE_ANALYTICS=false

# ─── Search / UX ──────────────────────────────────────────────────────────────
VITE_ALLOWED_SEARCH_LENGTH=100
VITE_SEARCH_DEBOUNCE_MS=300

# ─── AI Statement Assistant (optional, opt-in) ────────────────────────────────
# Free tier: 15 req/min, 1500 req/day. Local LLMs work without this key.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ─── VA.gov API integration master switch ────────────────────────────────────
# Set to `true` only when VA API access has been (re-)granted at developer.va.gov.
# When `false` (default), the entire VA-API surface is dark:
#   - VA OAuth login is short-circuited (no PKCE flow, no token exchange).
#   - VA API fetchers throw VA_API_DISABLED at call time.
#   - /callback and /sandbox-test routes redirect to "/".
#   - VaApiStatusBanner, VaIntegrationTest, VaSandboxTest, DemoDashboard render blocks are hidden.
# Re-enable steps (once VA access is restored):
#   1. Set VITE_VA_API_ENABLED=true in .env.local.
#   2. Verify VITE_VA_AUTH_ID, VITE_VA_REDIRECT_URL, VITE_VA_API_KEY are set below.
#   3. Restart `npm run dev`.
VITE_VA_API_ENABLED=false

# ─── VA.gov OAuth 2.0 (REQUIRED for VA Integration Demo) ──────────────────────
# Register at developer.va.gov — Authorization Code Grant with PKCE.
# Redirect URI must match exactly what you submitted on the sandbox access form.
# These are read but ignored while VITE_VA_API_ENABLED=false.
VITE_VA_AUTH_ID=your_va_client_id_here
VITE_VA_REDIRECT_URL=http://localhost:5173/callback

# 'sandbox' for development; 'production' only after VA grants production access.
VITE_VA_API_ENV=sandbox

# OAuth API path — must match the API selected on the sandbox access form.
#   veteran-verification/v1  — Service History, Disability Ratings, Veteran Status
#   claims/v1                — Benefits Claims API
VITE_VA_OAUTH_API_PATH=veteran-verification/v1

# Required OAuth scopes when registering at developer.va.gov:
#   openid, profile, offline_access,
#   claim.read, service_history.read,
#   appealable_issues.read, appeals_status.read

# ─── VA Facilities API key (separate from OAuth, for VSO Finder) ──────────────
# https://developer.va.gov/explore/api/va-facilities/sandbox-access
VITE_VA_API_KEY=your_va_api_key_here

# ─── Google Drive cloud sync (optional) ───────────────────────────────────────
# Required scope: https://www.googleapis.com/auth/drive.file
VITE_GOOGLE_DRIVE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com

# ─── Feedback remote endpoints (all optional, all OFF by default) ─────────────
# Optional FormSubmit.co (or similar) URLs for sending user-submitted feedback to
# the operator. Leave EMPTY (the default) to disable remote send entirely — in
# that case the submission is saved locally only and NO user content leaves the
# device. When set, all user-authored free-text is PII-scrubbed before send.
# If you enable any of these, disclose the third-party processor in the privacy policy.
VITE_BUG_REPORT_ENDPOINT=
VITE_FEATURE_REQUEST_ENDPOINT=
VITE_ROADMAP_ENDPOINT=
