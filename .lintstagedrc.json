{
  "*.{ts,tsx,mts,cts,js,mjs,cjs}": [
    "eslint --fix --max-warnings 0 --no-warn-ignored",
    "prettier --write"
  ],
  "*.{json}": ["prettier --write"],
  "*.{yaml,yml}": ["prettier --write"],
  "*.md": ["markdownlint-cli2 --fix", "prettier --write"],
  "*.{css,scss}": ["prettier --write"],
  "*.vue": [
    "eslint --fix --max-warnings 0 --no-warn-ignored",
    "stylelint --fix",
    "prettier --write"
  ]
}
