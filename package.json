{
  "name": "veteran-disability-search",
  "version": "1.30.4",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Comprehensive veteran disability search and resource guide using eCFR data",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:webgpu": "pwsh -File scripts/launch-chrome-dev.ps1",
    "dev:chrome": "pwsh -File scripts/launch-chrome-dev.ps1",
    "dev:supplylocker": "cross-env VITE_BRAND_MODE=supplylocker vite",
    "build": "npm run sync-version && npm run update-stats && npm run update-docs && npm run sync-legal-pages && npm run check-legal-pages && vite build && npm run check:dist-secrets",
    "build:vetrate": "cross-env VITE_BRAND_MODE=vetrate npm run build",
    "build:supplylocker": "cross-env VITE_BRAND_MODE=supplylocker vite build --outDir dist-supplylocker",
    "build:all": "node scripts/build-brands.js",
    "build:analyze": "cross-env ANALYZE=true vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\"",
    "type-check": "tsc --noEmit",
    "sync-version": "node scripts/sync-version.js",
    "update-stats": "node scripts/update-stats.js",
    "update-docs": "node scripts/update-docs.js",
    "update-changelog": "node scripts/update-changelog.js",
    "changelog-preview": "node scripts/update-changelog.js --preview",
    "release": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "release:preview": "node scripts/release.js --preview",
    "sync-legal-pages": "node scripts/sync-legal-pages.js",
    "check-legal-pages": "node scripts/generate-legal-pages.js",
    "legal-sync": "node scripts/generate-legal-pages.js",
    "sync-user-manual": "node scripts/sync-user-manual.js",
    "version-bump": "npm version patch && npm run sync-version",
    "version-auto": "node scripts/smart-version.js",
    "version-preview": "node scripts/smart-version.js --dry-run",
    "squash-bug": "node scripts/squash-bug.js",
    "pre-deploy": "node scripts/pre-deploy-check.js",
    "pre-deploy:quick": "node scripts/pre-deploy-check.js --skip-build",
    "push-prep": "node scripts/push-prep.js",
    "push-prep:patch": "node scripts/push-prep.js --patch",
    "push-prep:minor": "node scripts/push-prep.js --minor",
    "push-prep:quick": "node scripts/push-prep.js --skip-checks -y",
    "update-forms": "node scripts/fetch-dbqs.js",
    "fetch-dbqs": "node scripts/fetch-dbqs.js",
    "check-vision": "node scripts/check-vision-model-fix.js",
    "va-data": ".venv/Scripts/python.exe scripts/scrapers/va_data_pipeline.py --generate-frontend",
    "va-data:full": ".venv/Scripts/python.exe scripts/scrapers/va_data_pipeline.py --full-update",
    "va-data:bva": ".venv/Scripts/python.exe scripts/scrapers/va_data_pipeline.py --condition",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:red-team": "vitest run src/__tests__/red-team",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test tests/e2e/mobile.spec.ts --project=mobile-chrome",
    "test:e2e:axe": "playwright test tests/e2e/axe.spec.ts --project=chromium",
    "test:e2e:cwv": "playwright test tests/e2e/cwv.spec.ts --project=mobile-chrome",
    "test:e2e:pwa": "playwright test tests/e2e/pwa.spec.ts --project=chromium",
    "test:e2e:core": "playwright test tests/e2e/accessibility.spec.ts tests/e2e/ai-pipeline.spec.ts tests/e2e/cfile-packet.spec.ts tests/e2e/dialog-contract.spec.ts tests/e2e/error-boundary.spec.ts tests/e2e/safety.spec.ts tests/e2e/search.spec.ts tests/e2e/smoke.spec.ts tests/e2e/tactical-calculator.spec.ts tests/e2e/tool-launch-matrix.spec.ts tests/e2e/tool-with-packet.spec.ts --project=chromium --project=firefox",
    "stress:cfile": "node scripts/stress/run-cfile-stress.mjs --spec cfile",
    "stress:muster": "node scripts/stress/run-cfile-stress.mjs --spec muster",
    "stress:all": "node scripts/stress/run-cfile-stress.mjs --spec both",
    "postinstall": "node scripts/copy-wasm.mjs",
    "prepare": "husky",
    "preflight": "node scripts/preflight.js",
    "preflight:fast": "node scripts/preflight.js --fast",
    "preflight:full": "node scripts/preflight.js --report",
    "preflight:push": "node scripts/preflight.js --push",
    "preflight:extras": "node scripts/preflight-extras.mjs",
    "preflight:extras:soft": "node scripts/preflight-extras.mjs --soft",
    "check:markdown": "node scripts/preflight-extras.mjs --only=markdown",
    "check:knip": "node scripts/preflight-extras.mjs --only=knip",
    "check:licenses": "node scripts/preflight-extras.mjs --only=licenses",
    "check:dist-secrets": "node scripts/check-dist-secrets.mjs",
    "check-bundle-budget": "node scripts/check-bundle-budget.mjs",
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:tokens:verify": "node scripts/build-tokens.mjs --verify",
    "eval:rag": "node scripts/legal-ingestion/eval/run-eval.mjs",
    "eval:rag:json": "node scripts/legal-ingestion/eval/run-eval.mjs --json",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "audit:baseline": "node scripts/audit-baseline.mjs",
    "audit:deps": "osv-scanner --lockfile package-lock.json",
    "audit:licenses": "license-checker --production --excludePrivatePackages --onlyAllow \"MIT;MIT*;Apache-2.0;BSD-2-Clause;BSD-3-Clause;BSD*;ISC;CC0-1.0;Unlicense;0BSD;BlueOak-1.0.0;(MIT OR CC0-1.0);(MIT AND Zlib);(MIT OR GPL-3.0-or-later)\"",
    "audit:secrets": "gitleaks detect --no-banner",
    "audit:deps:interactive": "npx npm-check-updates"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@mlc-ai/web-llm": "^0.2.80",
    "@wllama/wllama": "^3.4.1",
    "d3-geo": "^3.1.1",
    "docx": "^9.5.1",
    "dompurify": "file:packages/dompurify-noop",
    "driver.js": "^1.4.0",
    "html2canvas": "^1.4.1",
    "idb-keyval": "^6.2.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.11.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.530",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.3.8",
    "react-markdown": "^10.1.0",
    "sharp": "file:packages/sharp-noop",
    "tesseract.js": "^7.0.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@axe-core/react": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.11.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.23.3",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^4.1.0",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "dompurify": "$dompurify",
    "sharp": "$sharp",
    "@xmldom/xmldom": "^0.8.13",
    "protobufjs": "^7.6.4",
    "tar": "^7.5.16"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": "^9.0.0"
  }
}
