{
    "name": "veteran-disability-search",
    "version": "1.20.0",
    "description": "Comprehensive veteran disability search and resource guide using eCFR data",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:webgpu": "pwsh -File scripts/launch-chrome-dev.ps1",
        "dev:chrome": "pwsh -File scripts/launch-chrome-dev.ps1",
        "dev:supplylocker": "cross-env VITE_BRAND_MODE=supplylocker vite",
        "build": "npm run sync-version && npm run update-stats && npm run update-docs && npm run sync-legal-pages && npm run check-legal-pages && vite build",
        "build:vetrate": "cross-env VITE_BRAND_MODE=vetrate npm run build",
        "build:supplylocker": "cross-env VITE_BRAND_MODE=supplylocker vite build --outDir dist-supplylocker",
        "build:all": "node scripts/build-brands.js",
        "preview": "vite preview",
        "lint": "eslint src --ext .js,.jsx",
        "format": "prettier --write \"src/**/*.{js,jsx,css}\"",
        "type-check": "tsc --noEmit",
        "sync-version": "node scripts/sync-version.js",
        "update-stats": "node scripts/update-stats.js",
        "update-docs": "node scripts/update-docs.js",
        "update-changelog": "node scripts/update-changelog.js",
        "changelog-preview": "node scripts/update-changelog.js --preview",
        "release": "node scripts/release.js patch",
        "release:minor": "node scripts/release.js minor",
        "release:major": "node scripts/release.js major",
        "release:preview": "node scripts/release.js --preview",
        "sync-legal-pages": "node scripts/sync-legal-pages.js",
        "check-legal-pages": "node scripts/generate-legal-pages.js",
        "legal-sync": "node scripts/generate-legal-pages.js",
        "sync-user-manual": "node scripts/sync-user-manual.js",
        "version-bump": "npm version patch && npm run sync-version",
        "version-auto": "node scripts/smart-version.js",
        "version-preview": "node scripts/smart-version.js --dry-run",
        "squash-bug": "node scripts/squash-bug.js",
        "pre-deploy": "node scripts/pre-deploy-check.js",
        "pre-deploy:quick": "node scripts/pre-deploy-check.js --skip-build",
        "push-prep": "node scripts/push-prep.js",
        "push-prep:patch": "node scripts/push-prep.js --patch",
        "push-prep:minor": "node scripts/push-prep.js --minor",
        "push-prep:quick": "node scripts/push-prep.js --skip-checks -y",
        "update-forms": "node scripts/fetch-dbqs.js",
        "fetch-dbqs": "node scripts/fetch-dbqs.js",
        "check-vision": "node scripts/check-vision-model-fix.js",
        "va-data": ".venv/Scripts/python.exe scripts/scrapers/va_data_pipeline.py --generate-frontend",
        "va-data:full": ".venv/Scripts/python.exe scripts/scrapers/va_data_pipeline.py --full-update",
        "va-data:bva": ".venv/Scripts/python.exe scripts/scrapers/va_data_pipeline.py --condition",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "prepare": "husky",
        "preflight": "node scripts/preflight.js",
        "preflight:fast": "node scripts/preflight.js --fast",
        "preflight:full": "node scripts/preflight.js --report",
        "preflight:push": "node scripts/preflight.js --push"
    },
    "dependencies": {
        "@huggingface/transformers": "^3.8.1",
        "@mlc-ai/web-llm": "^0.2.80",
        "@wllama/wllama": "^2.3.7",
        "docx": "^9.5.1",
        "driver.js": "^1.4.0",
        "html2canvas": "^1.4.1",
        "idb-keyval": "^6.2.1",
        "jspdf": "^4.2.1",
        "lucide-react": "^0.562.0",
        "mammoth": "^1.11.0",
        "pdf-lib": "^1.17.1",
        "pdfjs-dist": "^5.4.530",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-dropzone": "^14.3.8",
        "react-markdown": "^10.1.0",
        "tesseract.js": "^7.0.0"
    },
    "devDependencies": {
        "@axe-core/react": "^4.11.1",
        "@playwright/test": "^1.58.2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^25.5.0",
        "@vitejs/plugin-react": "^4.2.0",
        "@vitest/coverage-v8": "^4.1.0",
        "autoprefixer": "^10.4.16",
        "axe-core": "^4.11.1",
        "cross-env": "^10.1.0",
        "eslint": "^8.52.0",
        "eslint-plugin-react": "^7.33.2",
        "husky": "^9.1.7",
        "jsdom": "^29.0.0",
        "lint-staged": "^16.4.0",
        "postcss": "^8.4.31",
        "prettier": "^3.1.0",
        "tailwindcss": "^3.3.0",
        "terser": "^5.46.0",
        "vite": "^6.0.0",
        "vitest": "^4.1.0",
        "vitest-axe": "^0.1.0"
    },
    "overrides": {
        "dompurify": "file:packages/dompurify-noop"
    },
    "engines": {
        "node": ">=18.0.0",
        "npm": "^9.0.0"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx}": [
            "eslint --fix",
            "prettier --write"
        ]
    }
}
