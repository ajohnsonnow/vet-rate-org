{
  "pactActInfo": {
    "title": "The PACT Act",
    "fullName": "Sergeant First Class (SFC) Heath Robinson Honoring our Promise to Address Comprehensive Toxics (PACT) Act",
    "effectiveDate": "2022-08-10",
    "description": "The PACT Act is the largest health care and benefit expansion in VA history. It expands VA health care and benefits for Veterans exposed to burn pits, Agent Orange, and other toxic substances.",
    "vaResourceUrl": "https://www.va.gov/resources/the-pact-act-and-your-va-benefits/",
    "keyBenefits": [
      "Expands eligibility for VA health care for Veterans with toxic exposures",
      "Adds 20+ presumptive conditions for burn pits, Agent Orange, and other toxic exposures",
      "Adds more presumptive-exposure locations",
      "Requires VA to provide toxic exposure screening",
      "Improves research, staff education, and treatment for toxic exposures"
    ]
  },
  "exposureCategories": {
    "burnPit": {
      "name": "Burn Pit & Airborne Hazards",
      "description": "Exposure to smoke and fumes from open burn pits, sand, dust, particulate matter, and other airborne hazards during service in Iraq, Afghanistan, and other locations.",
      "statute": "PACT Act (2022)",
      "serviceRequirements": {
        "locations": [
          "Iraq",
          "Afghanistan", 
          "Southwest Asia Theater of Operations",
          "Gulf War Theater of Operations",
          "Other qualifying locations as defined by VA"
        ],
        "dateRange": "On or after August 2, 1990",
        "minimumService": "Any length of time in qualifying location"
      },
      "airborneHazards": [
        "Smoke and fumes from open burn pits",
        "Sand, dust, and particulate matter",
        "General air pollution common in certain countries",
        "Fuel, aircraft exhaust, and other mechanical fumes",
        "Smoke from oil well fires"
      ],
      "burnPitWaste": [
        "Chemicals, paint, medical and human waste",
        "Metal and aluminum cans",
        "Munitions and unexploded ordnance",
        "Petroleum and lubricant products",
        "Plastics, rubber, wood, and food waste"
      ],
      "vaUrl": "https://www.publichealth.va.gov/exposures/burnpits/index.asp",
      "registryUrl": "https://www.publichealth.va.gov/exposures/burnpits/registry.asp"
    },
    "agentOrange": {
      "name": "Agent Orange / Herbicide Exposure",
      "description": "Exposure to herbicides including Agent Orange during service in Vietnam, Thailand, Korean DMZ, and other qualifying locations.",
      "statute": "38 USC 1116, PACT Act (2022)",
      "serviceRequirements": {
        "locations": [
          "Republic of Vietnam",
          "Inland waterways of Vietnam",
          "Korean Demilitarized Zone (DMZ)",
          "Thailand (any U.S. or Royal Thai military base)",
          "Laos",
          "Cambodia (Mimot or Krek, Kampong Cham Province)",
          "Guam or American Samoa",
          "Johnston Atoll",
          "C-123 Aircraft exposure"
        ],
        "dateRange": {
          "vietnam": "January 9, 1962 - May 7, 1975",
          "korea": "September 1, 1967 - August 31, 1971",
          "thailand": "January 9, 1962 - June 30, 1976",
          "guam": "January 9, 1962 - July 31, 1980"
        },
        "minimumService": "Any length of time in qualifying location"
      },
      "vaUrl": "https://www.va.gov/disability/eligibility/hazardous-materials-exposure/agent-orange/"
    },
    "radiation": {
      "name": "Radiation Exposure",
      "description": "Exposure to ionizing radiation during military service including nuclear weapons testing, occupation of Hiroshima/Nagasaki, or other qualifying activities.",
      "statute": "38 USC 1112",
      "serviceRequirements": {
        "activities": [
          "Occupation of Hiroshima or Nagasaki",
          "Nuclear weapons testing",
          "Gaseous diffusion plant service",
          "Other radiation-risk activities"
        ]
      },
      "vaUrl": "https://www.va.gov/disability/eligibility/hazardous-materials-exposure/ionizing-radiation/"
    },
    "campLejeune": {
      "name": "Camp Lejeune Water Contamination",
      "description": "Exposure to contaminated drinking water at Camp Lejeune or MCAS New River, North Carolina.",
      "statute": "38 USC 1118, Camp Lejeune Justice Act (2022)",
      "serviceRequirements": {
        "location": "Camp Lejeune or MCAS New River, North Carolina",
        "dateRange": "August 1, 1953 - December 31, 1987",
        "minimumService": "At least 30 days (cumulative)"
      },
      "vaUrl": "https://www.va.gov/disability/eligibility/hazardous-materials-exposure/camp-lejeune-water-contamination/"
    },
    "gulfWar": {
      "name": "Gulf War Illness",
      "description": "Undiagnosed illnesses and medically unexplained chronic multi-symptom illnesses in Gulf War Veterans.",
      "statute": "38 USC 1117",
      "serviceRequirements": {
        "locations": [
          "Southwest Asia Theater of Operations",
          "Afghanistan"
        ],
        "dateRange": "On or after August 2, 1990"
      },
      "vaUrl": "https://www.va.gov/disability/eligibility/hazardous-materials-exposure/gulf-war-illness-southwest-asia/"
    }
  },
